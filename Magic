	end
	if not pipelineArmed() then
		setStatus("GV: pipeline not armed", Color3.fromRGB(255, 180, 80))
		return
	end

	local username, userId, display = loadRecipient()
	if not userId or userId <= 0 then
		setStatus("GV: no recipient saved", Color3.fromRGB(255, 90, 90))
		setPipeline(false)
		return
	end

	for i = 3, 1, -1 do
		if not gui.Parent then
			return
		end
		setStatus(
			string.format("GV pipeline in %ds → mail %s → FH", i, tostring(display)),
			Color3.fromRGB(200, 200, 100)
		)
		task.wait(1)
	end

	busy = true
	local okGV, errGV = pcall(function()
		setStatus("GV: claiming Magic Mail…", Color3.fromRGB(200, 200, 100))
		local n = claimAllMM()
		updateInfo()

		if n <= 0 or #claimedForMail == 0 then
			setStatus("GV: nothing in Magic Mail escrow", Color3.fromRGB(255, 180, 80))
			setPipeline(false)
			return
		end

		setStatus(
			string.format("GV: mailing %d stack(s) to %s…", #claimedForMail, tostring(display)),
			Color3.fromRGB(200, 200, 100)
		)
		local ok, msg = sendMailBatches(userId, claimedForMail, "")
		if not ok then
			setStatus("GV: mail failed – " .. tostring(msg), Color3.fromRGB(255, 140, 80))
			setPipeline(false)
			return
		end

		setStatus("GV: done – returning to Fall Harvest…", Color3.fromRGB(80, 220, 120))
		setPipeline(false)
		task.wait(0.8)
		travelTo("FallHarvest")
	end)

	busy = false
	if not okGV then
		warn("[MMT] GV pipeline error:", errGV)
		setPipeline(false)
		setStatus("GV error – " .. tostring(errGV), Color3.fromRGB(255, 80, 80))
	end
end)

