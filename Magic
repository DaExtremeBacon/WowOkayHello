task.spawn(function()
	if not isFH() then
		return
	end
	setStatus("Fall Harvest – confirm user + arm loop", Color3.fromRGB(160, 160, 170))

	while gui.Parent and isFH() do
		local okLoop, errLoop = pcall(function()
			task.wait(10)
			if not gui.Parent or not isFH() or busy then
				return
			end
			if not fhArmed() then
				setStatus("FH loop idle", Color3.fromRGB(160, 160, 170))
				return
			end

			local username, userId, display = loadRecipient()
			local cat = catDrop.Get()
			local item = itemDrop.Get()
			local wantCount = math.floor(tonumber(countBox.Text) or 0)
			persistSelection()

			if not userId or userId <= 0 or not item or item == "" or wantCount <= 0 then
				setStatus("FH: missing recipient / item / count", Color3.fromRGB(255, 180, 80))
				return
			end

			busy = true
			setStatus(
				string.format("FH: checking mail from %s for %s…", tostring(display), item),
				Color3.fromRGB(200, 200, 100)
			)

			local okClaim, unitsFound, mailsClaimed, detail = claimMatchingFromUser(
				userId,
				display ~= "" and display or username,
				item,
				cat
			)

			if not okClaim then
				setStatus(string.format("FH: waiting – %s", tostring(detail)), Color3.fromRGB(255, 180, 80))
				busy = false
				updateInfo()
				return
			end

			-- Must have enough units from mail for the full requested amount
			if unitsFound < wantCount then
				setStatus(
					string.format(
						"FH: only got %d/%d of %s from mail – waiting for more",
						unitsFound, wantCount, item
					),
					Color3.fromRGB(255, 180, 80)
				)
				busy = false
				updateInfo()
				return
			end

			local sendCount = wantCount -- full amount only
			task.wait(0.6)

			local tier = lowestTierFor(item, cat)
			local need = math.ceil(sendCount / unitsPerMail(cat))
			setStatus(
				string.format(
					"FH: claimed enough → Magic-Mailing %s x%d via %s (%d mail(s))…",
					item, sendCount, tostring(tier), need
				),
				Color3.fromRGB(200, 200, 100)
			)

			local ok, msg, mailsUsed, unitsSent, tierUsed = magicMailSendTotal(cat, item, sendCount)

			-- HARD GATE: only travel if every unit was accepted
			if ok and unitsSent >= sendCount then
				setStatus(
					string.format(
						"FH: fully sent %d/%d with %d× %s – traveling GV…",
						unitsSent, sendCount, mailsUsed, tostring(tierUsed)
					),
					Color3.fromRGB(80, 220, 120)
				)
				setPipeline(true)
				busy = false
				task.wait(0.8)
				travelTo("Main")
				return "TRAVEL"
			else
				setStatus(
					string.format(
						"FH: incomplete Magic Mail %d/%d – %s (NO travel, retry)",
						unitsSent or 0, sendCount, tostring(msg)
					),
					Color3.fromRGB(255, 140, 80)
				)
				-- Do not arm GV pipeline on partial failure
				setPipeline(false)
				busy = false
				updateInfo()
			end
		end)

		if not okLoop then
			warn("[MMT] FH loop error:", errLoop)
			busy = false
			setStatus("FH loop error – " .. tostring(errLoop), Color3.fromRGB(255, 80, 80))
		elseif errLoop == "TRAVEL" then
			return
		end
	end
end)

