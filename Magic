local function makeDropdown(y, options, default)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -24, 0, 28)
	btn.Position = UDim2.fromOffset(12, y)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 46)
	btn.BorderSizePixel = 0
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 13
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.Text = "  " .. tostring(default or options[1] or "(none)")
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	local list = Instance.new("ScrollingFrame")
	list.BackgroundColor3 = Color3.fromRGB(36, 36, 42)
	list.BorderSizePixel = 0
	list.Visible = false
	list.ZIndex = 60
	list.ScrollBarThickness = 5
	list.Parent = frame
	Instance.new("UICorner", list).CornerRadius = UDim.new(0, 6)
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local current = default or options[1] or ""
	local onChanged = nil
	local optionButtons = {}

	local function rebuild(newOptions, keepValue)
		options = newOptions or {}
		for _, b in ipairs(optionButtons) do
			b:Destroy()
		end
		table.clear(optionButtons)
		if #options == 0 then
			current = ""
			btn.Text = "  (none)"
		elseif not keepValue or not table.find(options, current) then
			current = options[1]
			btn.Text = "  " .. tostring(current)
		else
			btn.Text = "  " .. tostring(current)
		end
		local h = math.min(130, math.max(28, #options * 26))
		list.Size = UDim2.new(1, -24, 0, h)
		list.CanvasSize = UDim2.fromOffset(0, #options * 26)
		list.Position = UDim2.fromOffset(12, y + 32)
		for i, opt in ipairs(options) do
			local ob = Instance.new("TextButton")
			ob.Size = UDim2.new(1, 0, 0, 26)
			ob.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
			ob.BorderSizePixel = 0
			ob.Font = Enum.Font.Gotham
			ob.TextSize = 12
			ob.TextColor3 = Color3.fromRGB(230, 230, 235)
			ob.TextXAlignment = Enum.TextXAlignment.Left
			ob.Text = "  " .. tostring(opt)
			ob.ZIndex = 61
			ob.LayoutOrder = i
			ob.Parent = list
			table.insert(optionButtons, ob)
			ob.MouseButton1Click:Connect(function()
				current = opt
				btn.Text = "  " .. tostring(opt)
				closeDropdown()
				if onChanged then
					onChanged(opt)
				end
			end)
		end
	end
	rebuild(options, true)

	btn.MouseButton1Click:Connect(function()
		if activeList == list then
			closeDropdown()
		else
			closeDropdown()
			list.Visible = true
			activeList, activeButton = list, btn
			ignoreNextOutside = true
		end
	end)

	return {
		Get = function()
			return current
		end,
		Set = function(v)
			current = v
			btn.Text = "  " .. tostring(v)
		end,
		SetOptions = function(opts, keep)
			rebuild(opts, keep)
		end,
		OnChanged = function(fn)
			onChanged = fn
		end,
	}
end

