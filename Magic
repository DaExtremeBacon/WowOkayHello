local function lowestTierFor(itemName, uiCat)
	local function inList(tier)
		if uiCat == "Seeds" then
			for _, n in ipairs(SEEDS[tier] or {}) do
				if n == itemName then
					return true
				end
			end
			return false
		end
		for _, g in ipairs(GEARS[tier] or {}) do
			if g.name == itemName then
				return true
			end
		end
		return false
	end
	if inList("Rare Magic Mail") then
		return "Rare Magic Mail"
	end
	if inList("Legendary Magic Mail") then
		return "Legendary Magic Mail"
	end
	if inList("Super Magic Mail") then
		return "Super Magic Mail"
	end
	return nil
end

local function unitsPerMail(uiCat)
	return (uiCat == "Seeds") and 10 or 1
end

local function packetCategoryFor(tier, uiCat, itemKey)
	if uiCat == "Seeds" then
		return "Seeds"
	end
	return gearCategory(tier, itemKey)
end

--[[
	Sends exactly totalCount units across as many Magic Mails as needed.
	Returns success ONLY if unitsSent == totalCount (full amount).
	Handles "Sending too fast" with retries + delay between mails.
]]
local function magicMailSendTotal(uiCat, itemKey, totalCount)
	totalCount = math.floor(tonumber(totalCount) or 0)
	if totalCount <= 0 then
		return false, "bad count", 0, 0, nil
	end
	if type(itemKey) ~= "string" or itemKey == "" then
		return false, "no item", 0, 0, nil
	end
	if not Networking or not Networking.MagicMail or not Networking.MagicMail.Send then
		return false, "Send missing", 0, 0, nil
	end

	local tier = lowestTierFor(itemKey, uiCat)
	if not tier then
		return false, "item not Magic-Mailable", 0, 0, nil
	end

	local per = unitsPerMail(uiCat)
	local packetCategory = packetCategoryFor(tier, uiCat, itemKey)
	local remaining = totalCount
	local mailsUsed, unitsSent = 0, 0

	local BETWEEN_MAILS = 2.75
	local MAX_RETRIES = 5

	print(string.format(
		"[MMT] Plan: %s x%d → %s (%d/mail, need %d successful mail(s))",
		itemKey, totalCount, tier, per, math.ceil(totalCount / per)
	))

	while remaining > 0 do
		local batch = math.min(per, remaining)
		local success, message
		local attempt = 0

		while true do
			attempt += 1
			print("[MMT] MagicMail.Send", tier, packetCategory, itemKey, batch, "(try", attempt .. ")")

			local ok, s, m = pcall(function()
				return Networking.MagicMail.Send:Fire(tier, packetCategory, itemKey, batch)
			end)

			if not ok then
				return false, "client error: " .. tostring(s), mailsUsed, unitsSent, tier
			end

			success, message = s, m
			print("[MMT] response", success, message)

			if success == true then
				break
			end

			local msgStr = string.lower(tostring(message or ""))
			local tooFast = string.find(msgStr, "too fast", 1, true)
				or string.find(msgStr, "try again", 1, true)
				or string.find(msgStr, "cooldown", 1, true)
				or string.find(msgStr, "moment", 1, true)

			if tooFast and attempt < MAX_RETRIES then
				local waitSec = BETWEEN_MAILS + (attempt * 0.75)
				print("[MMT] Rate limited – waiting", waitSec, "s then retry")
				task.wait(waitSec)
			else
				-- Hard fail: do NOT report overall success
				return false, message or "rejected", mailsUsed, unitsSent, tier
			end
		end

		mailsUsed += 1
		unitsSent += batch
		remaining -= batch

		if remaining > 0 then
			print("[MMT] Waiting", BETWEEN_MAILS, "s before next Magic Mail…")
			task.wait(BETWEEN_MAILS)
		end
	end

	-- Gate: must have sent the full requested amount
	if unitsSent < totalCount then
		return false, string.format("partial send %d/%d", unitsSent, totalCount), mailsUsed, unitsSent, tier
	end

	return true, nil, mailsUsed, unitsSent, tier
end

-- ── Shared ──

local function normalizeList(result)
	local out = {}
	if type(result) ~= "table" then
		return out
	end
	local hasStringKeys = false
	for k, v in pairs(result) do
		if type(k) == "string" then
			hasStringKeys = true
			table.insert(out, { id = k, data = v })
		end
	end
	if hasStringKeys then
		return out
	end
	for _, v in ipairs(result) do
		if type(v) == "string" then
			table.insert(out, { id = v, data = v })
		elseif type(v) == "table" then
			table.insert(out, { id = v.Id or v.EscrowId or v.id, data = v })
		end
	end
	return out
end

local function escrowToMailEntry(data)
	if type(data) ~= "table" then
		return nil
	end
	local it = data.Item
	if type(it) ~= "table" then
		return nil
	end
	local cat = it.Category
	local name = it.ItemName or it.Name
	local count = tonumber(it.Count) or 1
	if type(cat) ~= "string" or type(name) ~= "string" or count <= 0 then
		return nil
	end
	return { Category = cat, ItemKey = name, Count = count }
end

local function mergeClaimed(entry)
	for _, e in ipairs(claimedForMail) do
		if e.Category == entry.Category and e.ItemKey == entry.ItemKey then
			e.Count += entry.Count
			return
		end
	end
	table.insert(claimedForMail, {
		Category = entry.Category,
		ItemKey = entry.ItemKey,
		Count = entry.Count,
	})
end

