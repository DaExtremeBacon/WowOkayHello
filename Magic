local function refreshMM()
	if not Networking or not Networking.MagicMail or not Networking.MagicMail.List then
		return
	end
	local ok, result = pcall(function()
		return Networking.MagicMail.List:Fire()
	end)
	if ok then
		pendingEscrow = normalizeList(result)
	end
end

local function claimMMId(id)
	local ok, success, message = pcall(function()
		return Networking.MagicMail.Claim:Fire(tostring(id))
	end)
	print("[MMT] MM Claim", id, success, message)
	return ok and success == true
end

local function claimAllMM()
	refreshMM()
	if #pendingEscrow == 0 or not isGV() then
		return 0
	end
	table.clear(claimedForMail)
	local n = 0
	for _, item in ipairs(pendingEscrow) do
		if claimMMId(item.id) then
			n += 1
			local e = escrowToMailEntry(item.data)
			if e then
				mergeClaimed(e)
			end
		end
		task.wait(0.45)
	end
	refreshMM()
	return n
end

local function buildBatches(entries, maxUnits)
	maxUnits = maxUnits or 20
	local batches, current, units = {}, {}, 0
	for _, e in ipairs(entries) do
		local left = e.Count
		while left > 0 do
			local room = maxUnits - units
			if room <= 0 then
				table.insert(batches, current)
				current, units, room = {}, 0, maxUnits
			end
			local take = math.min(left, room)
			table.insert(current, {
				Category = e.Category,
				ItemKey = e.ItemKey,
				Count = take,
			})
			units += take
			left -= take
		end
	end
	if #current > 0 then
		table.insert(batches, current)
	end
	return batches
end

local function sendMailBatches(userId, entries, note)
	if not Networking or not Networking.Mailbox or not Networking.Mailbox.SendBatch then
		return false, "SendBatch missing"
	end
	local batches = buildBatches(entries, 20)
	if #batches == 0 then
		return false, "no items"
	end
	for i, batch in ipairs(batches) do
		local ok, success, message = pcall(function()
			return Networking.Mailbox.SendBatch:Fire(userId, batch, note or "")
		end)
		print("[MMT] SendBatch", i, success, message)
		if not ok or success ~= true then
			return false, message or tostring(success)
		end
		if i < #batches then
			task.wait(1.75)
		end
	end
	return true, nil
end

