local function lookupPlayer(username)
	if not Networking or not Networking.Mailbox or not Networking.Mailbox.LookupPlayer then
		return nil, nil, "LookupPlayer missing"
	end
	local name = string.gsub(username or "", "^%s*@?", "")
	name = string.gsub(name, "%s+$", "")
	if #name < 3 then
		return nil, nil, "username too short"
	end
	local ok, userId, display = pcall(function()
		return Networking.Mailbox.LookupPlayer:Fire(name)
	end)
	if not ok then
		return nil, nil, tostring(userId)
	end
	if type(userId) ~= "number" or userId <= 0 then
		return nil, nil, display or "not found"
	end
	return userId, display or name, nil
end

