		warn("[MMT] OpenInbox error:", result)
		return nil
	end
	return result
end

local function iterInbox(result)
	local list = {}
	if type(result) ~= "table" then
		return list
	end

	local hasStringKeys = false
	for k, v in pairs(result) do
		if type(k) == "string" and type(v) == "table" then
			hasStringKeys = true
			table.insert(list, {
				Id = k,
				_keyId = k,
				data = v,
				raw = v,
			})
		end
	end
	if hasStringKeys then
		return list
	end

	if result[1] ~= nil then
		for _, v in ipairs(result) do
			if type(v) == "table" then
				table.insert(list, {
					Id = v.Id or v.MailId or v.id or v.Key,
					data = v,
					raw = v,
				})
			end
		end
		return list
	end

	for _, key in ipairs({ "Mail", "Inbox", "Entries", "Gifts", "Items" }) do
		if type(result[key]) == "table" then
			for k, v in pairs(result[key]) do
				if type(v) == "table" then
					local id = (type(k) == "string" and k) or v.Id or v.MailId or v.id
					table.insert(list, { Id = id, data = v, raw = v })
				end
			end
		end
	end
	return list
end

local function getMailId(row)
	if type(row) ~= "table" then
		return nil
	end
	if type(row.Id) == "string" and row.Id ~= "" then
		return row.Id
	end
	if type(row._keyId) == "string" then
		return row._keyId
	end
	local d = row.data or row.raw or row
	if type(d) == "table" then
		return d.Id or d.MailId or d.id or d.Key or d.mailId
	end
	return nil
end

local function mailSenderMatches(entry, targetUserId, targetName)
	local function check(t)
		if type(t) ~= "table" then
			return false
		end
		local uid = t.UserId or t.SenderUserId or t.FromUserId or t.SenderId or t.FromId
		if type(uid) == "number" and targetUserId > 0 and uid == targetUserId then
			return true
		end
		local n = t.Name or t.SenderName or t.FromName or t.Username or t.DisplayName or t.Sender
		if type(n) == "string" and targetName ~= "" and string.lower(n) == string.lower(targetName) then
			return true
		end
		if type(t.Sender) == "table" and check(t.Sender) then
			return true
		end
		if type(t.From) == "table" and check(t.From) then
			return true
		end
		return false
	end
	if check(entry) then
		return true
	end
	if type(entry) == "table" then
		return check(entry.data) or check(entry.raw)
	end
	return false
end

local function countWantedInEntry(entry, wantItem, wantCat)
	if not wantItem or wantItem == "" then
		return 0
	end
	local total = 0
	local function checkOne(it)
		if type(it) ~= "table" then
			return
		end
		local key = it.ItemKey or it.ItemName or it.Name or it.SeedName
		local cat = it.Category
		local c = tonumber(it.Count or it.Amount) or 1
		if type(key) == "string" and string.lower(key) == string.lower(wantItem) then
			if wantCat ~= "Seeds" or cat == nil or cat == "Seeds" then
				total += c
			end
		end
	end
	local function scan(t)
		if type(t) ~= "table" then
			return
		end
		checkOne(t)
		local items = t.Items or t.Batch or t.Contents or t.Gifts or t.Entry or t.Item
		if type(items) == "table" then
			if items.ItemKey or items.ItemName or items.Name then
				checkOne(items)
			else
				for _, it in pairs(items) do
					checkOne(it)
				end
			end
		end
	end
	scan(entry)
	if type(entry) == "table" then
		scan(entry.data)
		scan(entry.raw)
	end
	return total
end

local function claimMailId(id)
	if not id or not Networking or not Networking.Mailbox or not Networking.Mailbox.Claim then
		return false
	end
	local ok, success, message = pcall(function()
		return Networking.Mailbox.Claim:Fire(tostring(id))
	end)
	print("[MMT] Mailbox.Claim", id, "→", success, message)
	return ok and success == true
end

local function claimMatchingFromUser(targetUserId, targetName, wantItem, wantCat)
	local inbox = openInbox()
	if inbox == nil then
		return false, 0, 0, "OpenInbox failed"
	end

	if not dumpedInboxOnce and type(inbox) == "table" then
		dumpedInboxOnce = true
		local n = 0
		for k, v in pairs(inbox) do
			n += 1
			if n <= 4 then
				local keys = {}
				if type(v) == "table" then
					for fk in pairs(v) do
						table.insert(keys, tostring(fk))
					end
				end
				print("[MMT] inbox key=", tostring(k), " valueKeys=", table.concat(keys, ","))
			end
		end
	end

	local entries = iterInbox(inbox)
	print("[MMT] Inbox entries:", #entries)
	if #entries == 0 then
		return false, 0, 0, "inbox empty"
	end

	local unitsFound = 0
	local toClaim = {}

	for _, row in ipairs(entries) do
		local fromTarget = mailSenderMatches(row, targetUserId, targetName)
		local units = countWantedInEntry(row, wantItem, wantCat)
		local id = getMailId(row)

		if fromTarget and units > 0 then
			print("[MMT] From partner: id=", id, " units of", wantItem, "=", units)
			if id then
				unitsFound += units
				table.insert(toClaim, { id = id, units = units })
			else
				print("[MMT] SKIP – matched item but no mail id")
			end
		elseif units > 0 and not fromTarget then
			print("[MMT] Item match, sender mismatch, id=", id)
		end
	end

	if #toClaim == 0 then
		for _, row in ipairs(entries) do
			local units = countWantedInEntry(row, wantItem, wantCat)
			local id = getMailId(row)
			if units > 0 and id then
				print("[MMT] Fallback claim id=", id, " units=", units)
				unitsFound += units
				table.insert(toClaim, { id = id, units = units })
			end
		end
	end

	if #toClaim == 0 then
		return false, 0, 0, "no claimable matching mail"
	end

	local claimed = 0
	for _, row in ipairs(toClaim) do
		if claimMailId(row.id) then
			claimed += 1
		end
		task.wait(0.45)
	end

	if claimed <= 0 then
		return false, unitsFound, 0, "claim calls failed"
	end
	return true, unitsFound, claimed, "ok"
end

