--[[
	Regular mailbox – send Cornucopia
	Sends 1x "Cornucopia" (SeedPacks) to TARGET_NAME
	10 seconds after the script starts.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TARGET_NAME = "xXDARK_LORDXx101" -- change if needed
local ITEM_KEY = "Cornucopia"
local CATEGORY = "SeedPacks"
local COUNT = 1
local DELAY_BEFORE_START = 10

print("[CornucopiaMail] Loading…")

local Networking = require(ReplicatedStorage.SharedModules.Networking)

local function lookup(username)
	local ok, userId, display = pcall(function()
		return Networking.Mailbox.LookupPlayer:Fire(username)
	end)
	if not ok then
		return nil, nil, tostring(userId)
	end
	if type(userId) ~= "number" or userId <= 0 then
		return nil, nil, display or "not found"
	end
	return userId, display or username, nil
end

task.spawn(function()
	print(string.format("[CornucopiaMail] Waiting %ds…", DELAY_BEFORE_START))
	task.wait(DELAY_BEFORE_START)

	print("[CornucopiaMail] Looking up", TARGET_NAME)
	local userId, display, err = lookup(TARGET_NAME)
	if not userId then
		warn("[CornucopiaMail] Lookup failed:", err)
		return
	end
	print(string.format("[CornucopiaMail] Target: %s (%d)", tostring(display), userId))

	local entries = {
		{ Category = CATEGORY, ItemKey = ITEM_KEY, Count = COUNT },
	}

	print("--------------------------------------------------")
	print(string.format(
		"[CornucopiaMail] SendBatch: %s x%d → %s",
		ITEM_KEY, COUNT, tostring(display)
	))

	local ok, success, message = pcall(function()
		return Networking.Mailbox.SendBatch:Fire(userId, entries, "")
	end)

	if not ok then
		warn("[CornucopiaMail] Fire errored (client-side):", success)
		return
	end

	print("[CornucopiaMail] Server response:")
	print("  success =", success)
	print("  message =", message or "(nil)")

	if success == true then
		print(">>> SENT <<< Cornucopia mailed.")
	else
		warn(">>> FAILED <<<", message or "(no message)")
	end
	print("--------------------------------------------------")
end)
